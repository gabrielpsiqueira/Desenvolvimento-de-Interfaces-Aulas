### agendamentomed.html
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agendamento Pediátrico</title>
</head>
<body>
    <a>
        <h2>Agendamento - Alergologia Pediátrica</h2>
    </a>

    <h3>Dados do Responsável</h3>

    <label for="responsavel">Nome do Responsável*<span></span></label><br>
    <input type="text" id="responsavel" name="responsavel" required placeholder="Digite seu nome">
    <br><br>

    <label for="cpf">CPF do Responsável*<span></span></label><br>
    <input type="text" id="cpf" name="cpf" required placeholder="Digite seu CPF">
    <br><br>

    <label for="telefone">Telefone para Contato*<span></span></label><br>
    <input type="tel" id="telefone" name="telefone" required placeholder="Digite seu telefone">
    <br><br>

    <h3>Dados da Criança</h3>

    <label for="nome">Nome Completo*<span></span></label><br>
    <input type="text" id="nome" name="nome" required placeholder="Digite o nome da criança">
    <br><br>

    <label for="nascimento">Data de Nascimento*<span></span></label><br>
    <input type="date" id="nascimento" name="nascimento" required>
    <br><br>

    <label for="alergia">Tipo de Alergia ou Suspeita</label><br>
    <select id="alergia" name="alergia">
        <option value="">Selecione uma opção</option>
        <option value="alimentar">Alergia Alimentar</option>
        <option value="respiratoria">Alergia Respiratória</option>
        <option value="pele">Alergia de Pele</option>
        <option value="medicamentos">Alergia a Medicamentos</option>
        <option value="outra">Outra ou Não Identificada</option>
    </select>
    <br><br>

    <label for="sintomas">Descrição dos Sintomas</label><br>
    <textarea id="sintomas" name="sintomas" placeholder="Descreva os sintomas apresentados pela criança"></textarea>
    <br><br>

    <h3>Dados da Consulta</h3>

    <label for="data">Data da Consulta*<span></span></label><br>
    <input type="date" id="data" name="data" required>
    <br><br>

    <label for="horario">Horário*<span></span></label><br>
    <input type="time" id="horario" name="horario" required>
    <br><br>

    <label for="observacoes">Observações Adicionais</label><br>
    <textarea id="observacoes" name="observacoes" placeholder="Informações adicionais"></textarea>
    <br><br>

    <button type="submit" onclick="return false;">Agendar Consulta</button>
    <a href="pasta.html" class="link">Voltar ao Login</a>
</body>
</html>
